// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Reservation {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  eventNumber Int
  name        String
  phone       String
  batch       String
  accommodationType String
  boardingDetails String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, eventNumber])
  @@index([date])
}

model DonationItem {
  id           String           @id @default(cuid())
  name         String
  category     String?
  note         String?
  type         String           @default("ITEM")
  targetAmount Float?
  unit         String?
  sortOrder    Int              @default(0)
  pledges      DonationPledge[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([sortOrder])
}

model DonationPledge {
  id        String       @id @default(cuid())
  itemId    String
  item      DonationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  batch     String
  faculty   String?
  amount    Float?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([itemId])
}
